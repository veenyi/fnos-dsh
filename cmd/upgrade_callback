#!/bin/bash

### DeepSeek Harness 升级回调 — 数据保留，权限与版本确认

set -e

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/fnos-dsh}"
TRIM_PKGHOME="${TRIM_PKGHOME:-/var/apps/fnos-dsh/home}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/fnos-dsh/var}"
DATA_DIR="${TRIM_PKGVAR}/data"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [upgrade] $1"
    echo "$msg"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    echo "$*" > "$TRIM_TEMP_LOGFILE"
}

trap 'toast_err "脚本出错(L${LINENO}): $(tail -3 "${LOG_FILE}" 2>/dev/null)"' ERR

log_msg "=== upgrade_callback start ==="

chmod 755 "${TRIM_APPDEST}/bin/node" 2>/dev/null || true
chmod 755 "${TRIM_APPDEST}/cmd/"* 2>/dev/null || true
chmod 755 "${TRIM_APPDEST}/cmd/main" 2>/dev/null || true
mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGHOME}" "${DATA_DIR}"
echo "$(cat "${TRIM_APPDEST}/manifest" 2>/dev/null | grep '^version' | awk '{print $3}')" > "${TRIM_PKGVAR}/app_version" 2>/dev/null || true

# 升级时若 settings.yaml 缺失（旧版无预置），补种聚合网关提供方
SETTINGS="${DATA_DIR}/settings.yaml"
if [ ! -f "${SETTINGS}" ]; then
    cat > "${SETTINGS}" <<'YAML'
llm-pi-ai:
  providers:
    sensenova:
      displayName: 聚合网关 (sensenova)
      apiKeyEnv: SENSENOVA_API_KEY
      api: openai-completions
      baseURL: https://token.sensenova.cn/v1
      models:
        - id: sensenova-6.7-flash-lite
        - id: deepseek-v4-flash
        - id: glm-5.2
YAML
    chmod 600 "${SETTINGS}" 2>/dev/null || true
    log_msg "settings.yaml preseeded on upgrade"
fi

if [ -n "${TRIM_USERNAME}" ]; then
    chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${TRIM_PKGVAR}" 2>>"${LOG_FILE}" || true
    chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${TRIM_PKGHOME}" 2>>"${LOG_FILE}" || true
fi

trap - ERR
log_msg "upgrade_callback finished."
exit 0
